# Every variable is optional. With all of them empty the site runs in demo mode.
AI_API_KEY=                  # Anthropic (console.anthropic.com) or OpenAI (platform.openai.com), for Ask UpNorth
STRIPE_SECRET_KEY=           # dashboard.stripe.com, for business listing payments
STRIPE_PRICE_ENHANCED=       # Stripe Price ID for the Enhanced tier
STRIPE_PRICE_FEATURED=       # Stripe Price ID for the Featured tier
NEWSLETTER_API_KEY=          # Mailchimp / ConvertKit / Resend, for the "Stay Up North" newsletter
EMAIL_API_KEY=               # Resend (resend.com/api-keys) / SendGrid, for new-listing notification emails
GOOGLE_MAPS_API_KEY=         # console.cloud.google.com (Maps Embed API), for real maps on town/listing pages
NEXT_PUBLIC_SITE_URL=        # Production URL for sitemap and Open Graph, e.g. https://upnorth.org (defaults to https://upnorth.org)
NEXT_PUBLIC_SUPABASE_URL=     # supabase.com > Project Settings > API, Project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY= # supabase.com > Project Settings > API, anon public key (used for admin sign-in)
SUPABASE_SERVICE_ROLE_KEY=    # supabase.com > Project Settings > API, service_role key. Server only, never expose
ADMIN_EMAIL=                  # Email of the Supabase Auth user allowed to open /admin
